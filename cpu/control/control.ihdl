MODULE CONTROL

IMPORT MUX
IMPORT ADDR_DECODER

INPUT IN[16]
INPUT ZR
INPUT NG

OUTPUT OUT[16]

LOW ZERO

HIGH ONE

WIRE IS_C
WIRE IS_F
WIRE IS_A
WIRE JUMP_BITS[3]
OUTPUT JUMP[8]

SPLIT IN A B C D E F G H I J K L M N O P

AND G0 A B TEMP0
BUF B0 TEMP0 IS_C

OR  O0 A     B     TEMP1
NOT N6 TEMP0 TEMP_NOT_AND_A_B
AND A0 TEMP_NOT_AND_A_B TEMP1 TEMP_XOR_A_B
AND A1 TEMP_XOR_A_B A TEMP_IS_F
BUF B1 TEMP_IS_F IS_F

NOT N1 IS_F  TEMP_IS_A_1
NOT N7 IS_C  TEMP_IS_A_2
AND A2 TEMP_IS_A_1 TEMP_IS_A_2 IS_A

MUX MUX0 ZERO K    IS_C M0
MUX MUX1 ZERO D    IS_C M1
MUX MUX2 ONE  ZERO IS_F M2
MUX MUX3 ZERO C    IS_F FC

MUX MUX4 ZERO    E    IS_C ZX
MUX MUX5 ZERO    F    IS_C NX
MUX MUX6 ZERO    G    IS_C TEMP_ZY
MUX MUX7 TEMP_ZY ONE  IS_F ZY
MUX MUX8 ZERO    H    IS_C NY
MUX MUX9 ZERO    I    IS_C TEMP_F
MUX MUXA TEMP_F  ONE  IS_F F
MUX MUXB ZERO    J    IS_C NO


MUX MUXC ZERO    M    IS_C LD
MUX MUXD ZERO    K    IS_C TEMP_LA
MUX MUXE TEMP_LA ONE  IS_A LA

MUX MUXF ZERO    L    IS_C WRAM
MUX MUXG ZERO    ONE  IS_F WROM

OR O1 WRAM WROM W

JOIN N O P JUMP_BITS
ADDR_DECODER D0 JUMP_BITS JUMP

SPLIT JUMP JMP JLE JNQ JLT JGE JEQ JGT NJMP     

MUX MUXH ZERO   ZERO   NJMP TEMP2 

OR O2 ZR NG OR_ZR_NG
NOT N2 OR_ZR_NG TEMP3
MUX MUXI TEMP2  TEMP3  JGT  TEMP4

AND G1 OR_ZR_NG ZR TEMP5
MUX MUXJ TEMP4  TEMP5  JEQ  TEMP6

NOT N3 NG TEMP7
MUX MUXK TEMP6  TEMP7  JGE  TEMP8

AND G2 OR_ZR_NG NG TEMP9
MUX MUXL TEMP8  TEMP9  JLT  TEMP10

NOT N4 ZR TEMP11
MUX MUXM TEMP10 TEMP11 JNQ  TEMP12

AND G3 ZR NG AND_ZR_NG
NOT N5 AND_ZR_NG NOT_AND_ZR_NG
AND G4 NOT_AND_ZR_NG OR_ZR_NG TEMP13
MUX MUXN TEMP12 TEMP13 JLE  TEMP14

MUX MUXO TEMP14 ONE    JMP  X

MUX MUXP ZERO    X    IS_C PC_LOAD

JOIN M0 M1 M2 FC ZX NX ZY NY F NO LD LA WRAM WROM W PC_LOAD OUT
