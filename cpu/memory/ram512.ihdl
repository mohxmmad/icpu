MODULE RAM512

IMPORT 16BITOR
IMPORT MUX16
IMPORT ADDR_DECODER
IMPORT RAM64

INPUT IN[16]
INPUT LOAD
INPUT RESET
INPUT ADDR[9]

CLOCK CLK

OUTPUT OUT[16]

WIRE ADDR8[8]

WIRE P[16]
WIRE Q[16]
WIRE R[16]
WIRE S[16]
WIRE T[16]
WIRE U[16]
WIRE V[16]
WIRE W[16]

WIRE ZERO16[16]

WIRE LOAD0[16]
WIRE LOAD1[16]
WIRE LOAD2[16]
WIRE LOAD3[16]
WIRE LOAD4[16]
WIRE LOAD5[16]
WIRE LOAD6[16]
WIRE LOAD7[16]

WIRE TEMP1[16]
