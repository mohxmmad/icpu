MODULE IRAM32K

IMPORT 16BITOR
IMPORT MUX16
IMPORT ADDR_DECODER
IMPORT RAM4K
IMPORT VRAM4K
IMPORT RESET_DECODER

INPUT IN[16]
INPUT LOAD
INPUT RESET
INPUT ADDR[15]

CLOCK CLK

OUTPUT OUT[16]
OUTPUT DISPLAY_DATA[131072]

WIRE ADDR8[8]

WIRE P[16]
WIRE Q[16]
WIRE R[16]
WIRE S[16]
WIRE T[16]
WIRE U[16]
WIRE V[16]
WIRE W[16]
WIRE DISPLAY_P[65536]
WIRE DISPLAY_Q[65536]

WIRE ZERO16[16]

WIRE LOAD0[16]
WIRE LOAD1[16]
WIRE LOAD2[16]
WIRE LOAD3[16]
WIRE LOAD4[16]
WIRE LOAD5[16]
WIRE LOAD6[16]
WIRE LOAD7[16]

WIRE TEMP1[16]
WIRE TEMP2[16]
WIRE TEMP3[16]
WIRE TEMP4[16]
WIRE TEMP5[16]
WIRE TEMP6[16]
WIRE TEMP7[16]
WIRE TEMP8[16]
WIRE TEMP9[16]
WIRE TEMPA[16]
WIRE TEMPB[16]
WIRE TEMPC[16]
WIRE TEMPD[16]
WIRE TEMPE[16]

WIRE ADDR3[3]
WIRE ADDR12[12]

LOW ZERO

SPLIT ADDR A0 A1 A2 A3 A4 A5 A6 A7 A8 A9 AA AB AC AD AE
JOIN A0 A1 A2 ADDR3
JOIN A3 A4 A5 A6 A7 A8 A9 AA AB AC AD AE ADDR12

ADDR_DECODER AD1 ADDR3 ADDR8

RESET_DECODER RD1 RESET ADDR8 A0 A1 A2 A3 A4 A5 A6 A7 

AND G1 A0 LOAD L0
AND G2 A1 LOAD L1
AND G3 A2 LOAD L2
AND G4 A3 LOAD L3
AND G5 A4 LOAD L4
AND G6 A5 LOAD L5
AND G7 A6 LOAD L6
AND G8 A7 LOAD L7

VRAM4K R0 IN L0 RESET ADDR12 CLK P DISPLAY_P
VRAM4K R1 IN L1 RESET ADDR12 CLK Q DISPLAY_Q
RAM4K R2 IN L2 RESET ADDR12 CLK R
RAM4K R3 IN L3 RESET ADDR12 CLK S
RAM4K R4 IN L4 RESET ADDR12 CLK T
RAM4K R5 IN L5 RESET ADDR12 CLK U
RAM4K R6 IN L6 RESET ADDR12 CLK V 
RAM4K R7 IN L7 RESET ADDR12 CLK W 

JOIN ZERO ZERO ZERO ZERO ZERO ZERO ZERO ZERO ZERO ZERO ZERO ZERO ZERO ZERO ZERO ZERO ZERO16

SPLIT ADDR8 A0 A1 A2 A3 A4 A5 A6 A7 

JOIN A0 A0 A0 A0 A0 A0 A0 A0 A0 A0 A0 A0 A0 A0 A0 A0 LOAD0
JOIN A1 A1 A1 A1 A1 A1 A1 A1 A1 A1 A1 A1 A1 A1 A1 A1 LOAD1
JOIN A2 A2 A2 A2 A2 A2 A2 A2 A2 A2 A2 A2 A2 A2 A2 A2 LOAD2
JOIN A3 A3 A3 A3 A3 A3 A3 A3 A3 A3 A3 A3 A3 A3 A3 A3 LOAD3
JOIN A4 A4 A4 A4 A4 A4 A4 A4 A4 A4 A4 A4 A4 A4 A4 A4 LOAD4
JOIN A5 A5 A5 A5 A5 A5 A5 A5 A5 A5 A5 A5 A5 A5 A5 A5 LOAD5
JOIN A6 A6 A6 A6 A6 A6 A6 A6 A6 A6 A6 A6 A6 A6 A6 A6 LOAD6
JOIN A7 A7 A7 A7 A7 A7 A7 A7 A7 A7 A7 A7 A7 A7 A7 A7 LOAD7

MUX16 M0 ZERO16 P LOAD0 TEMP1
MUX16 M1 ZERO16 Q LOAD1 TEMP2
MUX16 M2 ZERO16 R LOAD2 TEMP3
MUX16 M3 ZERO16 S LOAD3 TEMP4
MUX16 M4 ZERO16 T LOAD4 TEMP5
MUX16 M5 ZERO16 U LOAD5 TEMP6
MUX16 M6 ZERO16 V LOAD6 TEMP7
MUX16 M7 ZERO16 W LOAD7 TEMP8

16BITOR O1 TEMP1 TEMP2 TEMP9
16BITOR O2 TEMP3 TEMP4 TEMPA
16BITOR O3 TEMP5 TEMP6 TEMPB
16BITOR O4 TEMP7 TEMP8 TEMPC

16BITOR O5 TEMP9 TEMPA TEMPD
16BITOR O6 TEMPB TEMPC TEMPE

16BITOR O7 TEMPD TEMPE OUT
JOIN DISPLAY_P DISPLAY_Q DISPLAY_DATA
