MODULE VRAM8

IMPORT 16BITOR
IMPORT MUX16
IMPORT ADDR_DECODER
IMPORT REGISTER
IMPORT RESET_DECODER

INPUT IN[16]
INPUT LOAD
INPUT RESET
INPUT ADDR[3]

CLOCK CLK

OUTPUT OUT[128]

WIRE ADDR8[8]

WIRE P[16]
WIRE Q[16]
WIRE R[16]
WIRE S[16]
WIRE T[16]
WIRE U[16]
WIRE V[16]
WIRE W[16]

WIRE ZERO16[16]

WIRE LOAD0[16]
WIRE LOAD1[16]
WIRE LOAD2[16]
WIRE LOAD3[16]
WIRE LOAD4[16]
WIRE LOAD5[16]
WIRE LOAD6[16]
WIRE LOAD7[16]

LOW ZERO

ADDR_DECODER AD1 ADDR ADDR8

RESET_DECODER RD1 RESET ADDR8 A0 A1 A2 A3 A4 A5 A6 A7 

AND G1 A0 LOAD L0
AND G2 A1 LOAD L1
AND G3 A2 LOAD L2
AND G4 A3 LOAD L3
AND G5 A4 LOAD L4
AND G6 A5 LOAD L5
AND G7 A6 LOAD L6
AND G8 A7 LOAD L7

REGISTER R0 IN L0 RESET CLK P
REGISTER R1 IN L1 RESET CLK Q
REGISTER R2 IN L2 RESET CLK R
REGISTER R3 IN L3 RESET CLK S
REGISTER R4 IN L4 RESET CLK T
REGISTER R5 IN L5 RESET CLK U
REGISTER R6 IN L6 RESET CLK V
REGISTER R7 IN L7 RESET CLK W

JOIN P Q R S T U V W OUT

