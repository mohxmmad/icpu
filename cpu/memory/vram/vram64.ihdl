MODULE VRAM64

IMPORT 16BITOR
IMPORT MUX16
IMPORT ADDR_DECODER
IMPORT VRAM8
IMPORT RESET_DECODER

INPUT IN[16]
INPUT LOAD
INPUT RESET
INPUT ADDR[6]

CLOCK CLK

OUTPUT OUT[1024]

WIRE ADDR8[8]

WIRE P[128]
WIRE Q[128]
WIRE R[128]
WIRE S[128]
WIRE T[128]
WIRE U[128]
WIRE V[128]
WIRE W[128]

WIRE ZERO16[16]

WIRE LOAD0[16]
WIRE LOAD1[16]
WIRE LOAD2[16]
WIRE LOAD3[16]
WIRE LOAD4[16]
WIRE LOAD5[16]
WIRE LOAD6[16]
WIRE LOAD7[16]

WIRE ADDR31[3]
WIRE ADDR32[3]

LOW ZERO

SPLIT ADDR A0 A1 A2 A3 A4 A5
JOIN A0 A1 A2 ADDR31
JOIN A3 A4 A5 ADDR32

ADDR_DECODER AD1 ADDR31 ADDR8

RESET_DECODER RD1 RESET ADDR8 A0 A1 A2 A3 A4 A5 A6 A7 

AND G1 A0 LOAD L0
AND G2 A1 LOAD L1
AND G3 A2 LOAD L2
AND G4 A3 LOAD L3
AND G5 A4 LOAD L4
AND G6 A5 LOAD L5
AND G7 A6 LOAD L6
AND G8 A7 LOAD L7

VRAM8 R0 IN L0 RESET ADDR32 CLK P
VRAM8 R1 IN L1 RESET ADDR32 CLK Q
VRAM8 R2 IN L2 RESET ADDR32 CLK R
VRAM8 R3 IN L3 RESET ADDR32 CLK S
VRAM8 R4 IN L4 RESET ADDR32 CLK T
VRAM8 R5 IN L5 RESET ADDR32 CLK U
VRAM8 R6 IN L6 RESET ADDR32 CLK V
VRAM8 R7 IN L7 RESET ADDR32 CLK W

JOIN P Q R S T U V W OUT
