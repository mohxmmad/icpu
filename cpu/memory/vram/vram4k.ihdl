MODULE VRAM4K

IMPORT 16BITOR
IMPORT MUX16
IMPORT ADDR_DECODER
IMPORT VRAM512
IMPORT RESET_DECODER

INPUT IN[16]
INPUT LOAD
INPUT RESET
INPUT ADDR[12]

CLOCK CLK

OUTPUT OUT[65536]

WIRE ADDR8[8]

WIRE P[8192]
WIRE Q[8192]
WIRE R[8192]
WIRE S[8192]
WIRE T[8192]
WIRE U[8192]
WIRE V[8192]
WIRE W[8192]

WIRE ZERO16[16]

WIRE LOAD0[16]
WIRE LOAD1[16]
WIRE LOAD2[16]
WIRE LOAD3[16]
WIRE LOAD4[16]
WIRE LOAD5[16]
WIRE LOAD6[16]
WIRE LOAD7[16]

WIRE ADDR3[3]
WIRE ADDR9[9]

LOW ZERO

SPLIT ADDR A0 A1 A2 A3 A4 A5 A6 A7 A8 A9 AA AB
JOIN A0 A1 A2 ADDR3
JOIN A3 A4 A5 A6 A7 A8 A9 AA AB ADDR9

ADDR_DECODER AD1 ADDR3 ADDR8

RESET_DECODER RD1 RESET ADDR8 A0 A1 A2 A3 A4 A5 A6 A7 

AND G1 A0 LOAD L0
AND G2 A1 LOAD L1
AND G3 A2 LOAD L2
AND G4 A3 LOAD L3
AND G5 A4 LOAD L4
AND G6 A5 LOAD L5
AND G7 A6 LOAD L6
AND G8 A7 LOAD L7

VRAM512 R0 IN L0 RESET ADDR9 CLK P
VRAM512 R1 IN L1 RESET ADDR9 CLK Q
VRAM512 R2 IN L2 RESET ADDR9 CLK R
VRAM512 R3 IN L3 RESET ADDR9 CLK S
VRAM512 R4 IN L4 RESET ADDR9 CLK T
VRAM512 R5 IN L5 RESET ADDR9 CLK U
VRAM512 R6 IN L6 RESET ADDR9 CLK V
VRAM512 R7 IN L7 RESET ADDR9 CLK W

JOIN P Q R S T U V W OUT

