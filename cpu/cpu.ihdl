MODULE CPU

IMPORT CONTROL
IMPORT ALU
IMPORT COUNTER
IMPORT REGISTER
IMPORT MUX16

INPUT INSTRUCTION[16]
INPUT DATA[16]
INPUT RESET

CLOCK CLK

OUTPUT OUT[16]
OUTPUT LRAM
OUTPUT LROM
OUTPUT DATA_ADDR[15]
OUTPUT INSTRUCTION_ADDR[15]
OUTPUT INSTRUCTION_SELECTOR[16]
OUTPUT WRITE

WIRE CONTROL_OUT[16]
WIRE ZR
WIRE NG

WIRE M016[16]
WIRE M116[16]
WIRE M216[16]
WIRE FC16[16]

WIRE IN_A[16]
WIRE IN_D[16]
WIRE OUT_A[16]
WIRE PC_OUT[16]
WIRE ALU_OUT[16]
WIRE X[16]
WIRE Y[16]

WIRE TEMP_ROM_ADDR[16]
WIRE CONTROL_BITS[6]

LOW ZERO
HIGH ONE

CONTROL CONTROL_UNIT INSTRUCTION ZR NG CONTROL_OUT

SPLIT CONTROL_OUT M0 M1 M2 FC ZX NX ZY NY F NO LD LA WRAM WROM W PC_LOAD
JOIN M0 M0 M0 M0 M0 M0 M0 M0 M0 M0 M0 M0 M0 M0 M0 M0 M016
JOIN M1 M1 M1 M1 M1 M1 M1 M1 M1 M1 M1 M1 M1 M1 M1 M1 M116
JOIN M2 M2 M2 M2 M2 M2 M2 M2 M2 M2 M2 M2 M2 M2 M2 M2 M216
JOIN FC FC FC FC FC FC FC FC FC FC FC FC FC FC FC FC FC16

MUX16 MUX0 INSTRUCTION ALU_OUT M016 IN_A
REGISTER A IN_A LA RESET CLK OUT_A

MUX16 MUX1 OUT_A DATA M116 Y

COUNTER PC OUT_A PC_LOAD RESET ONE CLK PC_OUT

BUF B0 ALU_OUT IN_D
REGISTER D IN_D LD RESET CLK X

JOIN ZX NX ZY NY F NO CONTROL_BITS
ALU HACK_ALU X Y CONTROL_BITS ALU_OUT ZR NG

MUX16 MUX2 OUT_A PC_OUT M216 TEMP_ROM_ADDR
SPLIT TEMP_ROM_ADDR V0 V1 V2 V3 V4 V5 V6 V7 V8 V9 VA VB VC VD VE VF
JOIN V1 V2 V3 V4 V5 V6 V7 V8 V9 VA VB VC VD VE VF INSTRUCTION_ADDR

SPLIT OUT_A H0 H1 H2 H3 H4 H5 H6 H7 H8 H9 HA HB HC HD HE HF
JOIN H1 H2 H3 H4 H5 H6 H7 H8 H9 HA HB HC HD HE HF DATA_ADDR

BUF B1 WRAM LRAM
BUF B2 WROM LROM
BUF B3 FC16 INSTRUCTION_SELECTOR
BUF B4 W WRITE
BUF B5 ALU_OUT OUT
