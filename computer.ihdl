MODULE COMPUTER

IMPORT IRAM32K
IMPORT ROM32K
IMPORT DISPLAY_CONTROLLER
IMPORT KEYBOARD
IMPORT CPU
IMPORT MUX16
IMPORT MUX
IMPORT KEYBOARD_COMPARATOR

INPUT RESET

CLOCK CLK1
CLOCK CLK2

OUTPUT OUT[16]

LOW ZERO
HIGH ONE

WIRE CPU_OUT[16]
WIRE WRAM
WIRE WROM
WIRE INST_ADDR[15]
WIRE INST[16]
WIRE ADDR[15]
WIRE DATA[16]
WIRE INSTRUCTION[16]
WIRE DATA_ADDR[15]
WIRE INST_SELECTOR[16]
WIRE DATA_ADDR_TEMP[16]
WIRE INST_ADDR_TEMP[16]
WIRE ADDR_TEMP[16]
WIRE DISPLAY_DATA[131072]
WIRE KEY_OUT[16]
WIRE RAM_DATA[16]
WIRE KEYBOARD_FLAG[16]
WIRE KEYBOARD_ADDR[15]
WIRE RESET16[16]
WIRE ZERO16[16]

JOIN ZERO ZERO ZERO ZERO ZERO ZERO ZERO ZERO ZERO ZERO ZERO ZERO ZERO ZERO ZERO ZERO ZERO16
JOIN RESET RESET RESET RESET RESET RESET RESET RESET RESET RESET RESET RESET RESET RESET RESET RESET RESET16

ROM32K ROM CPU_OUT WROM ZERO INST_ADDR INST
IRAM32K RAM CPU_OUT WRAM RESET ADDR CLK1 RAM_DATA DISPLAY_DATA

MUX16 M3 INST RAM_DATA INST_SELECTOR INSTRUCTION


MUX16 M6 DATA        ZERO16 RESET16 DATA
MUX16 M7 INSTRUCTION ZERO16 RESET16 INSTRUCTION

CPU ICPU INSTRUCTION DATA RESET CLK1 CPU_OUT WRAM WROM DATA_ADDR INST_ADDR INST_SELECTOR WRITE

JOIN ZERO INST_ADDR INST_ADDR_TEMP
JOIN ZERO DATA_ADDR DATA_ADDR_TEMP

MUX16 M4 DATA_ADDR_TEMP INST_ADDR_TEMP INST_SELECTOR ADDR_TEMP 

SPLIT ADDR_TEMP X0 X1 X2 X3 X4 X5 X6 X7 X8 X9 XA XB XC XD XE XF
JOIN X1 X2 X3 X4 X5 X6 X7 X8 X9 XA XB XC XD XE XF ADDR

DISPLAY_CONTROLLER SCREEN DISPLAY_DATA

KEYBOARD KEY_INPUT_BOARD RESET CLK2 KEY_OUT 
JOIN ONE ZERO ONE ONE ONE ONE ONE ONE ONE ONE ONE ONE ONE ONE ONE KEYBOARD_ADDR
KEYBOARD_COMPARATOR KC DATA_ADDR KEYBOARD_ADDR KEYBOARD_FLAG
MUX16 M5 RAM_DATA KEY_OUT KEYBOARD_FLAG DATA

BUF B0 CPU_OUT OUT
