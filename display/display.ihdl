MODULE DISPLAY_CONTROLLER

IMPORT QUARTER
INPUT IN[131072]

WIRE A[32768]
WIRE B[32768]
WIRE C[32768]
WIRE D[32768]

SPLIT IN A B C D

WIRE_GRID BL0 256 128
QUARTER B0 A BL0
WIRE_GRID BL1 256 128
QUARTER B1 B BL1
WIRE_GRID BL2 256 128
QUARTER B2 C BL2
WIRE_GRID BL3 256 128
QUARTER B3 D BL3

DISPLAY SCREEN 512 256
GRID BL0 SCREEN 0 0
GRID BL1 SCREEN 0 128
GRID BL2 SCREEN 256 0
GRID BL3 SCREEN 256 128
