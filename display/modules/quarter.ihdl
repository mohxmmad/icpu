MODULE QUARTER

IMPORT MICRO_QUARTER

INPUT IN[32768]


WIRE A[8192]
WIRE B[8192]
WIRE C[8192]
WIRE D[8192]

SPLIT IN A B C D

WIRE_GRID BL0 128 64
MICRO_QUARTER B1 A BL0
WIRE_GRID BL1 128 64
MICRO_QUARTER B2 B BL1
WIRE_GRID BL2 128 64
MICRO_QUARTER B3 C BL2
WIRE_GRID BL3 128 64
MICRO_QUARTER B4 D BL3

OUTPUT_GRID OUT 256 128
GRID BL0 OUT 0 0
GRID BL1 OUT 0 64
GRID BL2 OUT 128 0
GRID BL3 OUT 128 64