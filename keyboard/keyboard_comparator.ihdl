MODULE KEYBOARD_COMPARATOR

IMPORT XORGATE

INPUT DATA_ADDR[15]
INPUT KEYBOARD_ADDR[15]

OUTPUT KEYBOARD_FLAG[16]

SPLIT DATA_ADDR A0 B0 C0 D0 E0 F0 G0 H0 I0 J0 K0 L0 M0 N0 O0
SPLIT KEYBOARD_ADDR A1 B1 C1 D1 E1 F1 G1 H1 I1 J1 K1 L1 M1 N1 O1

XORGATE X0 A0 A1 OUT0
XORGATE X1 B0 B1 OUT1
XORGATE X2 C0 C1 OUT2
XORGATE X3 D0 D1 OUT3
XORGATE X4 E0 E1 OUT4
XORGATE X5 F0 F1 OUT5
XORGATE X6 G0 G1 OUT6
XORGATE X7 H0 H1 OUT7
XORGATE X8 I0 I1 OUT8
XORGATE X9 J0 J1 OUT9
XORGATE XA K0 K1 OUTA
XORGATE XB L0 L1 OUTB
XORGATE XC M0 M1 OUTC
XORGATE XD N0 N1 OUTD
XORGATE XE O0 O1 OUTE

OR O0 OUT0 OUT1 OUTF
OR O1 OUT2 OUT3 OUTG
OR O2 OUT4 OUT5 OUTH
OR O3 OUT6 OUT7 OUTI
OR O4 OUT8 OUT9 OUTJ
OR O5 OUTA OUTB OUTK
OR O6 OUTC OUTD OUTL
OR O7 OUTE OUTF OUTM
OR O8 OUTG OUTH OUTN
OR O9 OUTI OUTJ OUTO
OR OA OUTK OUTL OUTP
OR OB OUTM OUTN OUTQ
OR OC OUTO OUTP OUTR
OR OD OUTQ OUTR INV_FLAG

NOT N0 INV_FLAG FLAG

JOIN FLAG FLAG FLAG FLAG FLAG FLAG FLAG FLAG FLAG FLAG FLAG FLAG FLAG FLAG FLAG FLAG KEYBOARD_FLAG

