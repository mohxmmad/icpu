MODULE CONTROL_KEY

IMPORT 16BITOR

OUTPUT PRESS[8]

LOW ZERO

WIRE TEMP1[16]
WIRE TEMP2[16]
WIRE TEMP3[16]
WIRE TEMP4[16]
WIRE TEMP5[16]
WIRE TEMP6[16]
WIRE TEMP7[16]
WIRE TEMP8[16]
WIRE TEMP9[16]
WIRE TEMP10[16]
WIRE TEMP11[16]

WIRE TEMP12[16]
WIRE TEMP13[16]
WIRE TEMP14[16]
WIRE TEMP15[16]
WIRE TEMP16[16]
WIRE TEMP17[16]
WIRE TEMP18[16]
WIRE TEMP19[16]
WIRE TEMP20[16]
WIRE TEMPFINAL[16]


BUTTON KEY_NULL   NUL 00000000
BUTTON KEY_SPACE SPC 00100000
BUTTON KEY_ENTER   ENT 00001101
BUTTON KEY_BACKSPACE   BSP 00001000
BUTTON KEY_ESCAPE  ESC 00011011
BUTTON KEY_TAB   TAB 00001001
BUTTON KEY_RUN   RUN 01111111
BUTTON KEY_UP    UP  00000001
BUTTON KEY_DOWN  DN  00000010
BUTTON KEY_LEFT  LF  00000011
BUTTON KEY_RIGHT RT  00000100

SPLIT KEY_NULL A B C D E F G H
JOIN ZERO ZERO ZERO ZERO ZERO ZERO ZERO ZERO A B C D E F G H TEMP1

SPLIT KEY_SPACE A B C D E F G H
JOIN ZERO ZERO ZERO ZERO ZERO ZERO ZERO ZERO A B C D E F G H TEMP2

SPLIT KEY_ENTER A B C D E F G H
JOIN ZERO ZERO ZERO ZERO ZERO ZERO ZERO ZERO A B C D E F G H TEMP3

SPLIT KEY_BACKSPACE A B C D E F G H
JOIN ZERO ZERO ZERO ZERO ZERO ZERO ZERO ZERO A B C D E F G H TEMP4

SPLIT KEY_ESCAPE A B C D E F G H
JOIN ZERO ZERO ZERO ZERO ZERO ZERO ZERO ZERO A B C D E F G H TEMP5

SPLIT KEY_TAB A B C D E F G H
JOIN ZERO ZERO ZERO ZERO ZERO ZERO ZERO ZERO A B C D E F G H TEMP6

SPLIT KEY_RUN A B C D E F G H
JOIN ZERO ZERO ZERO ZERO ZERO ZERO ZERO ZERO A B C D E F G H TEMP7

SPLIT KEY_UP A B C D E F G H
JOIN ZERO ZERO ZERO ZERO ZERO ZERO ZERO ZERO A B C D E F G H TEMP8

SPLIT KEY_DOWN A B C D E F G H
