MODULE KEYBOARD

IMPORT ALPH_KEY
IMPORT SPECIAL_KEY
IMPORT NUMBER_KEY
IMPORT CONTROL_KEY

IMPORT 16BITOR
IMPORT MUX16

LOW ZERO
HIGH ONE

WIRE PRESS1[8]
WIRE PRESS2[8]
WIRE PRESS3[8]
WIRE PRESS4[8]

WIRE TEMP1[16]
WIRE TEMP2[16]
WIRE TEMP3[16]
WIRE TEMP4[16]
WIRE TEMP5[16]
WIRE TEMP6[16]
WIRE TEMP7[16]

WIRE TEMP10[16]
WIRE KEY_EVENT[16]

LOW ZERO

OUTPUT OUT[16]

WIRE KEY_CODE[16]

ALPH_KEY D1 PRESS1
SPLIT PRESS1 A B C D E F G H
JOIN ZERO ZERO ZERO ZERO ZERO ZERO ZERO ZERO A B C D E F G H TEMP1

SPECIAL_KEY D2 PRESS2
SPLIT PRESS2 A B C D E F G H
JOIN ZERO ZERO ZERO ZERO ZERO ZERO ZERO ZERO A B C D E F G H TEMP2

NUMBER_KEY D3 PRESS3
SPLIT PRESS3 A B C D E F G H
JOIN ZERO ZERO ZERO ZERO ZERO ZERO ZERO ZERO A B C D E F G H TEMP3

CONTROL_KEY D5 PRESS4
SPLIT PRESS5 A B C D E F G H
JOIN ZERO ZERO ZERO ZERO ZERO ZERO ZERO ZERO A B C D E F G H TEMP4

16BITOR O1 TEMP1 TEMP2 TEMP5
16BITOR O2 TEMP3 TEMP4 TEMP6
16BITOR O3 TEMP5 TEMP6 TEMP7

BUF B1 TEMP7 KEY_CODE
SPLIT KEY_CODE A B C D E F G H I J K L M N O P

OR O0 I J Q
OR O1 K L R
OR O2 M N S
OR O3 O P T
OR O4 Q R U
OR O5 S T V
OR O6 U V W

JOIN W W W W W W W W W W W W W W W W KEY_EVENT

MUX16 M16 TEMP10 KEY_CODE KEY_EVENT TEMP10

BUF B2 TEMP10 OUT
