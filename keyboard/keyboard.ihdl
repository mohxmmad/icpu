MODULE KEYBOARD

IMPORT ALPH_KEY
IMPORT SPECIAL_KEY
IMPORT NUMBER_KEY
IMPORT SMALL_KEY
IMPORT CONTROL_KEY

IMPORT 16BITOR

WIRE PRESS1[8]
WIRE PRESS2[8]
WIRE PRESS3[8]
WIRE PRESS4[8]
WIRE PRESS5[8]

WIRE TEMP1[16]
WIRE TEMP2[16]
WIRE TEMP3[16]
WIRE TEMP4[16]
WIRE TEMP5[16]
WIRE TEMP6[16]
WIRE TEMP7[16]
WIRE TEMP8[16]
WIRE TEMP9[16]

LOW ZERO

OUTPUT OUT[8]

ALPH_KEY D1 PRESS1
SPLIT PRESS1 A B C D E F G H
JOIN ZERO ZERO ZERO ZERO ZERO ZERO ZERO ZERO A B C D E F G H TEMP1

SPECIAL_KEY D2 PRESS2
SPLIT PRESS2 A B C D E F G H
JOIN ZERO ZERO ZERO ZERO ZERO ZERO ZERO ZERO A B C D E F G H TEMP2

NUMBER_KEY D3 PRESS3
SPLIT PRESS3 A B C D E F G H
JOIN ZERO ZERO ZERO ZERO ZERO ZERO ZERO ZERO A B C D E F G H TEMP3

SMALL_KEY D4 PRESS4
SPLIT PRESS4 A B C D E F G H
JOIN ZERO ZERO ZERO ZERO ZERO ZERO ZERO ZERO A B C D E F G H TEMP4

CONTROL_KEY D5 PRESS5
SPLIT PRESS5 A B C D E F G H
JOIN ZERO ZERO ZERO ZERO ZERO ZERO ZERO ZERO A B C D E F G H TEMP5

16BITOR O1 TEMP1 TEMP2 TEMP6
16BITOR O2 TEMP3 TEMP4 TEMP7
16BITOR O3 TEMP5 TEMP6 TEMP8
16BITOR O4 TEMP7 TEMP8 TEMP9

SPLIT TEMP9 A B C D E F G H I J K L M N O P
JOIN I J K L M N O P OUT


